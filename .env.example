# Initial admin login. Applied ONLY when the database is first created --
# changing these later has no effect, change the password in the NPM UI.
NPM_ADMIN_EMAIL=admin@example.com
NPM_ADMIN_PASSWORD=changeme

# Address the admin UI binds to. Defaults to 127.0.0.1 (loopback only).
NPM_ADMIN_BIND=127.0.0.1

# External network shared with the cloudflared connector.
# Must already exist: docker network create cloudflared
CLOUDFLARE_TUNNEL_NETWORK=cloudflared

# Host path the /data volume archives are written to. Required -- there is no
# default, because a wrong one silently fills the node's local disk.
# Mount your NAS/backup volume here first.
NPMBACKUP_PATH=/mnt/npmbackup

# Days of archives to keep.
BACKUP_RETENTION_DAYS=14
